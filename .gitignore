# Use the .gitignore as a whitelist instead of a blacklist
*
!*/

# Fonts
!/fonts/**/*.ttf
!/fonts/**/*.txt

# App assets (e.g. launcher icon source)
!/assets/**/*.png
!/assets/**/*.jpg
!/assets/**/*.svg

# Source files
!/lib/**/*.dart
/lib/generated_plugin_registrant.dart
/lib/**/*.g.dart

# Localization files
!/lib/l10n/**/*.arb

# Android and iOS projects. Their own .gitignore files drop the generated parts.
!/android/**
!/ios/**
/android/build/
/android/.kotlin/
/android/**/*.iml
**/.DS_Store

# Flutter and dart project files
!/analysis_options.yaml
!/pubspec.yaml
!/l10n.yaml

# Website (GitHub Pages: support page, privacy policy, terms)
!/docs/**

# GitHub CI/CD workflow files
!/.github/workflows/**/*.yml

# Repository related files
!/.gitignore
!/README.md
!/CLAUDE.md
!/LICENSE
!/crowdin.yml
