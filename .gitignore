# Use the .gitignore as a whitelist instead of a blacklist
*
!*/

# Fonts
!/fonts/**/*.ttf
!/fonts/**/*.txt

# App assets (e.g. launcher icon source)
!/assets/**/*.png
!/assets/**/*.jpg
!/assets/**/*.svg

# Source files
!/lib/**/*.dart
/lib/generated_plugin_registrant.dart
/lib/**/*.g.dart

# Tests, with their fixture files
!/test/**

# Localization files
!/lib/l10n/**/*.arb

# Android and iOS projects. Their own .gitignore files drop the generated parts.
!/android/**
!/ios/**
/android/build/
/android/.kotlin/
/android/**/*.iml
**/.DS_Store

# Flutter and dart project files
!/analysis_options.yaml
!/pubspec.yaml
!/pubspec.lock
!/l10n.yaml

# Store automation (fastlane)
!/Gemfile
!/Gemfile.lock
!/fastlane/Fastfile

# Website (GitHub Pages: support page, privacy policy, terms)
!/docs/**

# GitHub CI/CD workflow files
!/.github/workflows/**/*.yml
!/.github/dependabot.yml
!/.github/ISSUE_TEMPLATE/*.yml

# Repository related files
!/.gitignore
!/.git-blame-ignore-revs
!/README.md
!/SECURITY.md
!/CLAUDE.md
!/LICENSE
