<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-transfer rules for Android 12 and higher (android:dataExtractionRules).
     Everything else is copied; the Twitch logins (access tokens) are not.
     See backup_rules.xml for why the paths look like this; keep both files in sync. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/twitchaccounts.hive" />
        <exclude domain="root" path="app_flutter/twitchaccounts.hivec" />
        <exclude domain="root" path="app_flutter/twitchaccounts.lock" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/twitchaccounts.hive" />
        <exclude domain="root" path="app_flutter/twitchaccounts.hivec" />
        <exclude domain="root" path="app_flutter/twitchaccounts.lock" />
    </device-transfer>
</data-extraction-rules>
