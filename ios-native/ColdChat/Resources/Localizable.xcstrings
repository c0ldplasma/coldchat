    "anErrorHasOccuredWhenVerifyingUserData": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'ha produït un error en verificar les dades de l'usuari:"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při ověřování osobních dat se objevil problém:"
