          "stringUnit": {
            "state": "translated",
            "value": "Παρουσιάστηκε ένα σφάλμα κατά την επαλήθευση δεδομένων χρήστη:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An error has occurred when verifying user data:"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "An error has occurred when verifying user data:"
          }
        },
        "en-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "An error has occurred when verifying user data:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha producido un error al verificar los datos de usuario:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur est survenue lors de la vérification des données utilisateur:"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שגיאה בעת אימות נתוני משתמש:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "An error has occurred when verifying user data:"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Došlo je do pogreške prilikom provjere korisničkih podataka:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un errore durante la verifica dei dati utente:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーデータの確認中にエラーが発生しました："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유저 데이터를 확인하는데 오류가 발생하였습니다:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det oppsto en feil med verifisering av bruker data:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een fout opgetreden bij het verifiëren van gebruikersgegevens:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystąpił problem podczas weryfikacji danych użytkownika:"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro ao verificar os dados do usuário:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Произошла ошибка при проверке данных пользователя:"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Greška se pojavila tokom verifikacije korisničkih podataka:"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett fel har uppstått vid verifiering av användardata:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı verisi onaylanırken bir sorun yaşandı:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có lỗi xảy ra khi xác thực dữ liệu người dùng:"
          }
        }
      }
    },
